# Ruta del repo en el host. En Windows usa preferiblemente barras simples o dobles con Docker Desktop.
HOST_REPO=G:/codex_projects/rust_cambia_nombre_planillas_he1

# Ruta dentro del contenedor donde se monta el repo.
WORKDIR=/work

# Carpeta host que contiene folders.sqlite y datos/datos. Se usa con docker-compose.objeciones.yml.
HE1_DATA_HOST_ROOT=/data_nuevo/repo_grande/data

# Modo por defecto: process | process_report | restore | report | telegram | objeciones | retry_objection_refresh
HE1_MODE=process_report

# Modo telegram: HE1_MODE=telegram para escuchar comandos desde Telegram.
# Requiere BOT token y chat autorizado.
# Credenciales del bot de Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Etiqueta usada al procesar y al restaurar/reportar.
HE1_LABEL=PATH_DIRECTORIOS

# Entrada para process: ruta dentro del contenedor.
HE1_INPUT=/work/fuentes_txt/PATH_DIRECTORIOS.txt

# Objetivo para restore/report: etiqueta o ruta al manifest dentro del contenedor.
# En process_report se usa como etiqueta del reporte final; si se omite, el programa usa HE1_LABEL.
HE1_TARGET=PATH_DIRECTORIOS

# Modo objeciones: raíz permitida para las carpetas resueltas desde folders.sqlite.
HE1_OBJECTION_DATA_ROOT=/data_nuevo/repo_grande/data/datos
HE1_OBJECTION_ORACLE_PORT=1521
HE1_OBJECTION_LABEL=
# En Docker, objeciones simula por defecto. Define false para aplicar cambios.
HE1_DRY_RUN=true

# Endpoint local de motor_redis. En Docker u otra máquina, indica su URL alcanzable.
# Debe incluir {tramite}; --dry-run no lo usa.
HE1_OBJECTION_REFRESH_URL_TEMPLATE=http://127.0.0.1:8091/api/cache/tramite/{tramite}

# SQLite de auditoría local del modo objeciones.
HE1_OBJECTION_AUDIT_SQLITE=uploads_audit.sqlite
