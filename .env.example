# Ruta del repo en el host. En Windows usa preferiblemente barras simples o dobles con Docker Desktop.
HOST_REPO=G:/codex_projects/rust_cambia_nombre_planillas_he1

# Ruta dentro del contenedor donde se monta el repo.
WORKDIR=/work

# Modo por defecto: process | process_report | restore | report | telegram
HE1_MODE=process_report

# Modo telegram: HE1_MODE=telegram para escuchar comandos desde Telegram.
# Requiere BOT token y chat autorizado.
# Credenciales del bot de Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Etiqueta usada al procesar y al restaurar/reportar.
HE1_LABEL=PATH_DIRECTORIOS

# Entrada para process: ruta dentro del contenedor.
HE1_INPUT=/work/fuentes_txt/PATH_DIRECTORIOS.txt

# Objetivo para restore/report: etiqueta o ruta al manifest dentro del contenedor.
# En process_report se usa como etiqueta del reporte final; si se omite, el programa usa HE1_LABEL.
HE1_TARGET=PATH_DIRECTORIOS
