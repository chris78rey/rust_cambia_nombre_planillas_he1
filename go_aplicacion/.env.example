# Oracle
ORACLE_DSN=oracle://usuario:password@host:1521/servicio
ORACLE_QUERY=SELECT table_name FROM user_tables ORDER BY table_name

# SQLite
SQLITE_DSN=file:local.db
SQLITE_QUERY=SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name
SQLITE_EXPORT=out/folders.csv

# Optional
TIMEOUT=30s
JSON_OUTPUT=false
